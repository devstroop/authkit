# Local development defaults. Never commit real secrets or production values.
AUTHKIT_ENV=development
AUTHKIT_BIND_ADDR=127.0.0.1:3000
AUTHKIT_ISSUER=http://localhost:3000
AUTHKIT_DATABASE_URL=sqlite://authkit.db?mode=rwc
AUTHKIT_DATABASE_MAX_CONNECTIONS=5
AUTHKIT_SIGNING_KEY_FILE=authkit-signing-keys.json
# Required 32-byte base64url key-encryption key. Generate a local value with:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
AUTHKIT_SIGNING_KEY_KEK=
AUTHKIT_SIGNING_KEY_RETIRED_PUBLISH_SECS=900
# Required 32-byte base64url pepper for session-token and CSRF HMACs. Use a different
# value from AUTHKIT_SIGNING_KEY_KEK and generate it with the same command above.
AUTHKIT_SESSION_PEPPER=
# Secure cookies are forced in production. Set this explicitly only for local overrides.
AUTHKIT_COOKIE_SECURE=false
AUTHKIT_SESSION_IDLE_SECS=1800
AUTHKIT_SESSION_ABSOLUTE_SECS=43200
AUTHKIT_ADMIN_SESSION_IDLE_SECS=900
AUTHKIT_ADMIN_SESSION_ABSOLUTE_SECS=28800
AUTHKIT_LOG_FORMAT=pretty
RUST_LOG=info
